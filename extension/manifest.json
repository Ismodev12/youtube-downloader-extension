{
  "manifest_version": 3,
  "name": "YT Téléchargeur",
  "version": "1.2.2",
  "description": "Ajoute un bouton Télécharger sur chaque vidéo YouTube (fonctionne avec le serveur local yt-dlp).",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Téléchargeur",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}